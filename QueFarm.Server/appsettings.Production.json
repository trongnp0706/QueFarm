{
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-production-server;Database=QueFarmDb;User Id=your-user;Password=your-password;TrustServerCertificate=true;"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-production-key-with-at-least-32-characters-change-this",
    "Issuer": "QueFarm",
    "Audience": "QueFarmUsers",
    "ExpirationInMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
