{
  "ConnectionStrings": {
    // IMPORTANT: Do not store production secrets in source control.
    // Provide this value via environment variable: ConnectionStrings__DefaultConnection
    "DefaultConnection": ""
  },
  "JwtSettings": {
    // Provide via environment variable: JwtSettings__SecretKey (minimum 32 chars)
    "SecretKey": "CHANGE_ME_IN_ENV",
    "Issuer": "QueFarm",
    "Audience": "QueFarmUsers",
    "ExpirationInMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "quefarm.page;www.quefarm.page"
} 