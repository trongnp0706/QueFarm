# Example environment variables file
# Copy this file to .env and configure with your values

# API Base URL for development
VITE_API_BASE_URL=https://localhost:7013

# For production, copy this file to .env.production and use your actual API URL
# VITE_API_BASE_URL=https://your-production-api.com

# Additional environment variables for different stages
# VITE_API_BASE_URL=https://staging-api.your-domain.com  # Staging
# VITE_API_BASE_URL=https://api.your-domain.com          # Production
